# ---------------------------------------------------------------------------
# Relations Hub — environment
# Local: copy to .env.local. Vercel: add the same names under
# Project → Settings → Environment Variables.
# ---------------------------------------------------------------------------

# Postgres connection string.
#   Local Docker:  postgresql://er:er_local_dev@127.0.0.1:5435/employee_relations
#   Vercel:        your production connection string (SSL is enabled automatically
#                  for any non-local host).
# Running locally, a non-local URL is refused unless ALLOW_REMOTE_DB=true.
DATABASE_URL=postgresql://er:er_local_dev@127.0.0.1:5435/employee_relations

# Auth.js — a long random string (e.g. `npx auth secret` or `openssl rand -base64 32`).
AUTH_SECRET=generate-a-long-random-string
AUTH_TRUST_HOST=true
# Local only. On Vercel leave it unset (Auth.js detects the deployment URL),
# or set it to your production domain.
NEXTAUTH_URL=http://localhost:3000

# OpenAI — optional. Without a key every AI feature uses the built-in local
# engine (meeting summaries, feedback organising, analytics insights); voice
# transcription needs the key.
OPENAI_API_KEY=
# Optional overrides
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional tuning
# DATABASE_POOL_MAX=3
# DATABASE_SSL=false

# Organisation timezone for "today" and due dates (IANA name).
# NEXT_PUBLIC_APP_TIMEZONE=Africa/Cairo
